{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "website",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "website", "run", "dev"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "website-eval",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "website", "run", "dev:eval"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "website-prod",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "website", "run", "start", "--", "--port", "4310"],
      "port": 4310
    },
    {
      "name": "storybook",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "storybook"],
      "port": 6006
    }
  ]
}
